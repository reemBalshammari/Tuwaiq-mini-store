@model mini_store.Models.Categories

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4" dir="rtl">

    <h2 class="mb-4">تعديل الفئة</h2>

    <form asp-action="Edit" method="post">

        <input asp-for="Id" type="hidden" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">اسم الفئة</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Icon" class="form-label">أيقونة الفئة</label>
            <input asp-for="Icon" class="form-control" />
            <span asp-validation-for="Icon" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">
            حفظ التعديل
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            رجوع
        </a>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}