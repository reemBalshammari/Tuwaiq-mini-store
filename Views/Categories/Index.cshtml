@model List<mini_store.Models.Categories>
@using System.Globalization

@{
    Layout = "_DashboardLayout";
    bool en = CultureInfo.CurrentUICulture.Name == "en-US";
    ViewData["Title"] = en ? "Categories" : "الفئات";
}

<div class="container mt-4">

    <h1 class="text-center mb-4">
        @(en ? "Categories" : "إدارة الفئات")
    </h1>

    <div class="card shadow">
        <div class="card-header">
            <h5 class="mb-0">
                @(en ? "Add New Category" : "إضافة فئة جديدة")
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label class="form-label">
                        @(en ? "Category Name" : "اسم الفئة")
                    </label>

                    <input type="text"
                           name="Name"
                           class="form-control"
                           placeholder="@(en ? "Enter Category Name" : "ادخل اسم الفئة")" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        @(en ? "Category Icon" : "أيقونة الفئة")
                    </label>

                    <input type="text"
                           name="Icon"
                           class="form-control"
                           placeholder="@(en ? "Enter Icon Code" : "ادخل كود الأيقونة")" />
                </div>

                <button type="submit" class="btn btn-success">
                    @(en ? "Save Category" : "حفظ الفئة")
                </button>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-secondary">
                    @(en ? "Back" : "رجوع")
                </a>

            </form>

        </div>
    </div>

    <div class="card shadow mt-5">

        <div class="card-body">

            <table class="table table-bordered table-hover text-center align-middle">

                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>@(en ? "Category Name" : "اسم الفئة")</th>
                        <th>@(en ? "Category Icon" : "أيقونة الفئة")</th>
                        <th>@(en ? "Actions" : "الإجراءات")</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="4">
                                @(en ? "No Categories Found" : "لا توجد فئات")
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.Id</td>

                                <td>@item.Name</td>

                                <td>@item.Icon</td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">

                                        @(en ? "Edit" : "تعديل")

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('@(en ? "Are you sure?" : "هل أنت متأكد؟")')">

                                        @(en ? "Delete" : "حذف")

                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>
        </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}