@model mini_store.Models.Product

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-4" dir="rtl">

    <h2 class="text-center mb-4">تعديل المنتج</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />
        <input asp-for="Image" type="hidden" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">اسم المنتج</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">سعر المنتج</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <div class="mb-3">
                <label class="form-label">الصورة الحالية</label><br />
                <img src="~/images/@Model.Image"
                     width="120"
                     class="img-thumbnail" />
            </div>
        }

        <div class="mb-3">
            <label asp-for="ImageFile" class="form-label">تغيير الصورة</label>
            <input asp-for="ImageFile"
                   type="file"
                   class="form-control" />
            <span asp-validation-for="ImageFile" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">الفئة</label>

            <select asp-for="CategoryId"
                    class="form-select"
                    asp-items="@(new SelectList(ViewBag.Categories,"Id","Name"))">
            </select>

            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">
            حفظ التعديل
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            رجوع
        </a>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}