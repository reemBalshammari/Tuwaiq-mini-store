@model List<mini_store.Models.Product>
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "_DashboardLayout";
    bool en = CultureInfo.CurrentUICulture.Name == "en-US";
    ViewData["Title"] = en ? "Products" : "المنتجات";
}

<div class="container mt-4">

    <h2 class="text-center mb-4">
        @(en ? "Dashboard" : "لوحة التحكم لإضافة المنتجات")
    </h2>

    <div class="card mb-3 border-0 bg-light shadow-sm">
        <div class="card-body">

            <form asp-action="Index" method="get" class="row g-3">

                <div class="col-md-9">

                    <label class="form-label fw-bold">
                        @(en ? "Search Product" : "ابحث باسم المنتج")
                    </label>

                    <input type="text"
                           name="searchTerm"
                           value="@ViewBag.CurrentSearch"
                           class="form-control"
                           placeholder="@(en ? "Enter product name" : "ادخل اسم المنتج")" />

                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">

                    <button type="submit" class="btn btn-primary w-100">
                        @(en ? "Search" : "بحث")
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        @(en ? "Reset" : "إلغاء")
                    </a>

                </div>

            </form>

        </div>
    </div>

    <div class="card shadow">

        <div class="card-header">
            @(en ? "Add New Product" : "إضافة منتج جديد")
        </div>

        <div class="card-body">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="mb-3">

                    <label class="form-label">
                        @(en ? "Product Name" : "اسم المنتج")
                    </label>

                    <input name="Name"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        @(en ? "Price" : "السعر")
                    </label>

                    <input name="Price"
                           type="number"
                           step="0.01"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        @(en ? "Image" : "الصورة")
                    </label>

                    <input name="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        @(en ? "Category" : "الفئة")
                    </label>

                    <select name="CategoryId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Categories,"Id","Name"))">

                        <option value="">
                            @(en ? "Select Category" : "اختر الفئة")
                        </option>

                    </select>

                </div>

                <button type="submit"
                        class="btn btn-success">
                    @(en ? "Save Product" : "حفظ المنتج")
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    @(en ? "Cancel" : "إلغاء")
                </a>

            </form>

        </div>

    </div>

    <br />

    <table class="table table-bordered table-hover text-center align-middle">

        <thead class="table-light">

            <tr>

                <th>#</th> 
                <th>
                    @(en ? "Product Name" : "اسم المنتج")
                </th>

                <th>
                    @(en ? "Price" : "السعر")
                </th>

                <th>
                    @(en ? "Image" : "الصورة")
                </th>

                <th>
                    @(en ? "Actions" : "الإجراءات")
                </th>

            </tr>

        </thead>

        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="5">
                        @(en ? "No Products Found" : "لا توجد منتجات")
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Id</td>

                        <td>@item.Name</td>

                        <td>@item.Price</td>

                        <td>

                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="~/images/@item.Image"
                                     alt="@item.Name"
                                     width="70"
                                     height="70"
                                     class="rounded"
                                     style="object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-muted">
                                    @(en ? "No Image" : "لا توجد صورة")
                                </span>
                            }

                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">

                                @(en ? "Edit" : "تعديل")

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('@(en ? "Are you sure you want to delete this product?" : "هل أنت متأكد من حذف هذا المنتج؟")')">

                                @(en ? "Delete" : "حذف")

                            </a>

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}